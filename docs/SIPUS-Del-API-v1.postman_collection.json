						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/bukus/1",
							"host": ["{{base_url}}"],
							"path": ["bukus", "1"]
						},
						"description": "Menolak penghapusan buku dengan status 409 Conflict jika buku masih memiliki peminjaman aktif."
					},
					"response": []
				},
				{
					"name": "12. DELETE Hapus Buku Sukses (204 No Content)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
