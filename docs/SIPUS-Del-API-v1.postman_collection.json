							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/bukus/{{buku_id}}",
							"host": ["{{base_url}}"],
							"path": ["bukus", "{{buku_id}}"]
