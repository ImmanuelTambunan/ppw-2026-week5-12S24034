						"description": "Menghapus buku yang tidak memiliki pinjaman aktif dengan status 204 No Content (body kosong)."
					},
					"response": []
				}
			]
		},
		{
			"name": "04 - Transaksi Sirkulasi ACID (Peminjaman & Pengembalian)",
			"item": [
				{
					"name": "1. GET Riwayat Peminjaman (200 OK)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
